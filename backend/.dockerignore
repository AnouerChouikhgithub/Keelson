# Nothing local travels into an image: dependencies are installed inside it.
vendor/
var/
node_modules/

# Local configuration and secrets. The tracked .env stays in the image: it holds
# the documented defaults (an empty APP_SECRET, a localhost URL) and Symfony's
# Dotenv requires the file to exist. Real values always come from the runtime
# environment, which overrides it.
.env.local
.env.*.local
.env.test.local

# Development and CI leftovers.
.phpunit.result.cache
.php-cs-fixer.cache
coverage/
tests/
bin/test-db.sh
docker-compose*.yml
Dockerfile
.dockerignore
*.log
