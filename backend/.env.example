# OIDC issuer and discovery URL for a Logto Cloud tenant.
OIDC_ISSUER=https://your-logto-tenant.logto.app/oidc
OIDC_WELL_KNOWN_URL=https://your-logto-tenant.logto.app/oidc/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-with-logto-client-id
OIDC_CLIENT_SECRET=replace-with-logto-client-secret
