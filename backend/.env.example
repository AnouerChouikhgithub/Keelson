# OIDC issuer and discovery URL for a Logto Cloud tenant.
OIDC_ISSUER=https://your-logto-tenant.logto.app/oidc
OIDC_WELL_KNOWN_URL=https://your-logto-tenant.logto.app/oidc/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-with-logto-client-id
OIDC_CLIENT_SECRET=replace-with-logto-client-secret

# Required per environment. Backend/.env.local only; never commit a value.
APP_SECRET=

# Local PostgreSQL (docker compose -p keelson up -d).
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/keelson?serverVersion=16&charset=utf8"

# Absolute URL used by CLI commands and absolute redirects. Required by the
# router (config/packages/routing.yaml). Use https:// in production.
DEFAULT_URI=http://127.0.0.1:8000

# Deployment-only values. Leave unset locally; the application accepts any Host
# header and trusts no proxy in development. In production, TRUSTED_HOSTS is
# mandatory (comma-separated hosts or one regex) and TRUSTED_PROXIES must be
# paired with TRUSTED_HEADERS. See docs/ENVIRONMENT_CONFIGURATION.md.
# TRUSTED_HOSTS=keelson.example.com
# TRUSTED_PROXIES=10.0.0.0/8
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host,x-forwarded-port
