
# Required per environment. Backend/.env.local only; never commit a value.
APP_SECRET=

# Local PostgreSQL (docker compose -p keelson up -d).
# The API serves as the least-privilege role `keelson_app`, which row-level
# security treats like production: it does not own the tables and cannot bypass a
# policy. DDL — creating the database, migrations, fixtures — runs as the owner
# `keelson_owner`; `bin/dev-reset.sh` uses the owner URL for that, and a manual
# migration is:
#
#   DATABASE_URL="postgresql://keelson_owner:keelson_owner@127.0.0.1:5433/keelson_dev?serverVersion=16&charset=utf8" php bin/console doctrine:migrations:migrate
#
# Both roles are created by docker/postgres/10-app-role.sh on a fresh volume. An
# existing volume keeps the roles it was created with; see README.md, "Roles and
# the local volume".
DATABASE_URL="postgresql://keelson_app:keelson_app@127.0.0.1:5433/keelson_dev?serverVersion=16&charset=utf8"

# Absolute URL used by CLI commands and absolute redirects. Required by the
# router (config/packages/routing.yaml). Use https:// in production.
DEFAULT_URI=http://127.0.0.1:8000

# Deployment-only values. Leave unset locally; the application accepts any Host
# header and trusts no proxy in development. In production, TRUSTED_HOSTS is
# mandatory (comma-separated hosts or one regex) and TRUSTED_PROXIES must be
# paired with TRUSTED_HEADERS. See docs/deployment.md, section 2 (Environment).
# TRUSTED_HOSTS=keelson.example.com
# TRUSTED_PROXIES=10.0.0.0/8
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host,x-forwarded-port

# Transactional email. Development uses the Mailpit container (docker compose up -d,
# web UI on http://localhost:8026). Tests use null://null.
MAILER_DSN=smtp://127.0.0.1:1026

# Origin of the SPA. Verification and password-reset emails link to it.
FRONTEND_URL=http://localhost:5173

# Refuse to sign in an account whose email address is not confirmed. Set false only
# where mail delivery does not exist yet; never in production.
REQUIRE_VERIFIED_EMAIL=true

# Shared password for the synthetic demo accounts seeded by app:fixtures:load.
# Optional: it defaults to the documented "Keelson-Demo-2026!" and must be at
# least 10 characters. Only ever read by a local test/dev database.
# FIXTURE_PASSWORD=

# AI foundation. Placeholders only: a real key belongs in .env.local or the
# deployment secret store, never in a tracked file. AI_ENABLED is the global
# switch every AI call consults; AI_PROVIDER=fake is deterministic and needs no
# network, any other value routes to the OpenAI-compatible HTTP provider.
AI_ENABLED=false
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
