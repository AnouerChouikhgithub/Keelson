			message: '#^Property App\\Entity\\Customer\:\:\$updatedAt is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Entity/Customer.php

		-
			message: '#^Property App\\Entity\\Invitation\:\:\$acceptedAt \(DateTimeImmutable\|null\) is never assigned DateTimeImmutable so it can be removed from the property type\.$#'
