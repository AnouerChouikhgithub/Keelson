parameters:
	ignoreErrors:
		-
			message: '#^Dead catch \- JsonException is never thrown in the try block\.$#'
			identifier: catch.neverThrown
			count: 1
			path: src/Controller/InvoiceApiController.php

		-
			message: '#^Property App\\Entity\\Customer\:\:\$id is never written, only read\.$#'
			identifier: property.onlyRead
			count: 1
			path: src/Entity/Customer.php

		-
			message: '#^Property App\\Entity\\Customer\:\:\$invoices is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Entity/Customer.php

